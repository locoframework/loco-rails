<h1>Published Articles</h1>

<section id="articles" data-container-component="admin-article"></section>

<%= loco_model_records "Article", @articles.map { |a|
    {
      id:             a.id,
      title:          a.title,
      text:           a.text,
      author:         a.user&.username,
      published_at:   a.published_at,
      comments_count: a.comments.count,
      admin_rate:     a.admin_rate
    }
  } %>