<h1>Users</h1>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Username</th>
      <th>Confirmed</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody data-container-component="admin-user">
  </tbody>
</table>

<%= loco_model_records "User", @users.map { |u|
    {
      id:        u.id,
      email:     u.email,
      username:  u.username,
      confirmed: u.confirmed?
    }
  } %>