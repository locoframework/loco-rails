<h1>Users</h1>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Username</th>
      <th>Confirmed</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
  </tbody>
</table>

<script type="application/json" id="users-data">
  <%= raw @users.map { |u|
    {
      id:        u.id,
      email:     u.email,
      username:  u.username,
      confirmed: u.confirmed?
    }
  }.to_json %>
</script>