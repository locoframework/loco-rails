<h1>RealSnapChat rooms</h1>

<table id='rooms_list'>
  <thead>
    <tr>
      <th>Name</th>
      <th>Members</th>
      <th></th>
    </tr>
  </thead>
  <tbody data-container-component="room-row"></tbody>
</table>

<%= will_paginate @rooms %>

<br>

<%= link_to 'New Room', new_user_room_path %>

<%= loco_model_records "Room", @rooms_with_hub.map { |os|
    {
      id:            os.room.id,
      name:          os.room.name,
      members_count: os.hub.raw_members.size,
      joined:        os.hub.include?(current_user)
    }
  } %>
