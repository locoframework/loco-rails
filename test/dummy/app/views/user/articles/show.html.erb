<div data-container-component="user-article-show"></div>

<section id="comments">
  <h4>Comments</h4>
  <p id="no_comments" data-component="no-comments">No comments.</p>
  <div data-container-component="user-comment"></div>
</section>

<%= link_to 'Edit', edit_user_article_path(@article), id: "edit_link" %> |
<%= link_to 'Back', user_articles_path %>

<%= loco_model_records "Article", [{
    id: @article.id,
    title: @article.title,
    text: @article.text,
    published_at: @article.published_at,
    comments_count: @article.comments.count
  }] %>

<%= loco_model_records "Article.Comment", @article.comments.map { |c|
    { id: c.id, article_id: c.article_id, author: c.author, text: c.text,
      created_at: c.created_at, approved: c.approved, emotion: c.emotion,
      pinned: c.pinned, admin_rate: c.admin_rate }
  } %>
