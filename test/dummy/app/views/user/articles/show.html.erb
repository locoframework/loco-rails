<p>
  <strong>Title:</strong>
  <span id="article_title"></span>
</p>

<p>
  <strong>Text:</strong>
  <span id="article_text"></span>
</p>

<p><a href="#" id="publish_article" style="display:none;">Publish</a></p>

<section id="comments">
  <h4>Comments</h4>
</section>

<%= link_to 'Edit', edit_user_article_path(id: 0), id: "edit_link" %> |
<%= link_to 'Back', user_articles_path %>

<script type="application/json" id="article-data">
  <%= raw({
    id: @article.id,
    title: @article.title,
    text: @article.text,
    published_at: @article.published_at,
    comments_count: @article.comments.count
  }.to_json) %>
</script>

<script type="application/json" id="comments-data">
  <%= raw(@article.comments.map { |c|
    { id: c.id, article_id: c.article_id, author: c.author, text: c.text,
      created_at: c.created_at, approved: c.approved, emotion: c.emotion,
      pinned: c.pinned, admin_rate: c.admin_rate }
  }.to_json) %>
</script>
