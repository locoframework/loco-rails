<h1>Listing Articles</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Text</th>
      <th>Comments</th>
      <th>Published</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody id='article_list' data-container-component="user-article">
  </tbody>
</table>

<br>

<%= link_to 'New Article', new_user_article_path %>

<script type="application/json" data-model="Article">
  <%= raw @articles.map { |a|
    {
      id:             a.id,
      title:          a.title,
      text:           a.text,
      comments_count: a.comments.count,
      published_at:   a.published_at
    }
  }.to_json %>
</script>
