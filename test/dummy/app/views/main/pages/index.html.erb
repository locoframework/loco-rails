<p class="text-right">
  <% if current_user %>
    <%= link_to "User panel", '/user' %>
  <% else %>
    <%= link_to "Sign in", new_user_session_url %> | <%= link_to "Sign up", new_user_url %>
  <% end %>
  <% if current_admin %>
    | <%= link_to "Admin panel", '/admin' %>
  <% end %>
</p>

<section id="articles" data-container-component="main-article"></section>

<hr>

<p id="load_more_wrapper" data-component="load-more"></p>

<script type="application/json" data-model="Article">
  <%= raw @articles.map { |a|
    {
      id:             a.id,
      title:          a.title,
      text:           a.text,
      author:         a.user&.username,
      published_at:   a.published_at,
      comments_count: a.comments.count
    }
  }.to_json %>
</script>