<article>
  <h1 id='title'></h1>
  <p><i>
    <span id='author'></span> wrote this on
    <span id='pub_date'></span> /
    <a id='comments_count' href='#comments'></a>
  </i></p>
  <section id='text'></section>
</article>

<h3>Comments</h3>

<section id='comments' class='bottom-space'></section>

<%= form_for [Article.new(id: 0), Comment.new] do |f| %>
  <div class="field" data-attr="author">
    <%= f.text_field :author, placeholder: "Name (required)" %>
    <span class="errors" data-for="author"></span>
  </div>

  <div class="field" data-attr="text">
    <%= f.text_area :text, placeholder: "Type your thoughts here..." %>
    <span class="errors" data-for="text"></span>
  </div>

  <div class="actions">
    <%= f.submit "Post this comment" %>
    <span class="errors" data-for="base"></span>
  </div>
<% end %>

<p>
  <%= link_to "Go back", root_url %>
</p>

<script type="application/json" id="article-data">
  <%= raw({
    id: @article.id,
    title: @article.title,
    text: @article.text,
    author: @article.user&.username,
    published_at: @article.published_at,
    comments_count: @article.comments.count
  }.to_json) %>
</script>

<script type="application/json" id="comments-data">
  <%= raw(@article.comments.map { |c|
    { id: c.id, article_id: c.article_id, author: c.author, text: c.text,
      created_at: c.created_at, approved: c.approved, emotion: c.emotion,
      pinned: c.pinned, admin_rate: c.admin_rate }
  }.to_json) %>
</script>